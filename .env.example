# Skopiuj ten plik jako .env i uzupełnij. Pliku .env NIGDY nie wrzucaj do gita.

# Token od @BotFather
TELEGRAM_TOKEN=

# Twoje Telegram ID (od @userinfobot). Kilka osób: oddziel przecinkami, np. 123,456
# Jak zostawisz puste, bot każdemu odpisze "brak dostępu" i pokaże jego ID.
ALLOWED_USER_IDS=

# Mózg: Ollama
OLLAMA_URL=http://localhost:11434
# Model. Na kartę z 8 GB VRAM polecam qwen3:8b (ollama pull qwen3:8b). Starszy: qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
# Tryb myślenia (tylko modele myślące, np. qwen3): 0 = szybciej, 1 = mądrzej ale wolniej, puste = nie ruszaj
OLLAMA_THINK=
# Ile fantazji: 0.2 = konkretny, 0.8 = kreatywny
OLLAMA_TEMPERATURE=0.4

# Ile ostatnich wiadomości (Twoich + MLG) pamiętać w rozmowie
HISTORY_LIMIT=20

# Domyślne miasto do pogody (np. Warszawa)
DEFAULT_CITY=

# Gdzie MLG trzyma bazę z pamięcią (folder poza gitem)
DATA_DIR=data

# Poranny brief: o której MLG ma wysłać podsumowanie dnia (GG:MM). Puste = wyłączony.
BRIEF_TIME=07:30

# HUD na pulpit: lokalna strona z kołem MLG (tylko na tym komputerze). 0 = wyłączony.
HUD_PORT=8044
# Czy otwierać HUD w przeglądarce przy starcie (1/0)
HUD_AUTO_OPEN=1
